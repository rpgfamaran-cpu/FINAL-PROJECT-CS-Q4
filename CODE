import json
import os

file = "data.json"

def load_data():
    if os.path.exists(file):
        f = open(file, "r")
        data = json.load(f)
        f.close()
        return data
    else:
        return []

def save_data(data):
    f = open(file, "w")
    json.dump(data, f, indent=4)
    f.close()

def create_user():
    data = load_data()

    id = int(input("Enter ID: "))
    name = input("Enter name: ")
    email = input("Enter email: ")
    grades = input("Enter grades of the student: ")

    user = {"id": id, "name": name, "email": email, "grades": grades}

    data.append(user)
    save_data(data)

    print("User added.")

def read_users():
    data = load_data()

    if data == []:
        print("No users found.")
    else:
        for u in data:
            print("ID:", u["id"], "| Name:", u["name"], "| Email:", u["email"], "| Grades:", u["grades"])

def update_user():
    data = load_data()

    uid = int(input("Update User ID: "))
    found = False

    for u in data:
        if u["id"] == uid:
            new_name = input("New name: ")
            new_email = input("New email: ")
            new_grades = input("New grades: ")

            u["name"] = new_name
            u["email"] = new_email
            u["grades"] = new_grades

            found = True

    if found:
        save_data(data)
        print("User updated.")
    else:
        print("User not found.")

def delete_user():
    data = load_data()

    uid = int(input("Delete User ID: "))
    new_data = []

    for u in data:
        if u["id"] != uid:
            new_data.append(u)

    if len(new_data) == len(data):
        print("User not found.")
    else:
        save_data(new_data)
        print("User deleted.")
while True:

    print("1 - Add User")
    print("2 - View Users")
    print("3 - Update User")
    print("4 - Delete User")
    print("5 - Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        create_user()
    elif choice == "2":
        read_users()
    elif choice == "3":
        update_user()
    elif choice == "4":
        delete_user()
    elif choice == "5":
        break
    else:
        print("Invalid choice")
